MODULE pai_0100 INPUT.
  CASE g_ok_code.
    WHEN 'CANCEL'.
      g_rc = 'C'.
      set screen 0. leave screen.
    WHEN 'CONTINUE'.
      g_rc = 'O'.
      set screen 0. leave screen.
  ENDCASE.
ENDMODULE.                 " PAI_0100  INPUT
