     <FULL_NAME>\PR:/CADAXO/CL_SQLC_COCKPIT_PARSE=CP\EX:/CADAXO/SQLC_EHN_S_CLS_SE_005\EI</FULL_NAME>
     <SOURCE>
      <item>*...</item>
      <item>  CONSTANTS: lc_cs_active TYPE flag VALUE abap_true.</item>
     </SOURCE>
    </ENH_HOOK_IMPL>
