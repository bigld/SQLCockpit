    <LINES>
     <TLINE>
      <TDFORMAT>U1</TDFORMAT>
      <TDLINE>SQL Cockpit - OData Template Wizard</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>*</TDFORMAT>
      <TDLINE>The OData Service can be generated now with the specified input.</TDLINE>
     </TLINE>
     <TLINE>
      <TDLINE>Afterwards you can adapt the service within transaction SEGW.</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>T2</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Project Name&lt;/&gt;,,,,&amp;CDXPROJECT_NAME&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Package&lt;/&gt;,,,,&amp;CDXPACKAGE&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Entity&lt;/&gt;,,,,&amp;CDXENTITY&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Entity Set&lt;/&gt;,,,,&amp;CDXENTITY_SET&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Register Service&lt;/&gt;,,,,&amp;CDXREGSER&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Filter&lt;/&gt;,,,,&amp;CDXFILTER&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Orderby&lt;/&gt;,,,,&amp;CDXORDER&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Top&lt;/&gt;,,,,&amp;CDXTOP&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Skip&lt;/&gt;,,,,&amp;CDXSKIP&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;ZH&gt;Count&lt;/&gt;,,,,&amp;CDXCOUNT&amp;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>&lt;!KEYS!&gt;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>*</TDFORMAT>
      <TDLINE>To start the service generation choose &lt;ZH&gt;Generate OData&lt;/&gt;.</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>*</TDFORMAT>
      <TDLINE>You can change the data with &lt;ZH&gt;Back&lt;/&gt; or the explicit step link.</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>/</TDFORMAT>
      <TDLINE>You can leave the wizard with &lt;ZH&gt;Cancel.&lt;/&gt;</TDLINE>
     </TLINE>
     <TLINE>
      <TDFORMAT>*</TDFORMAT>
     </TLINE>
