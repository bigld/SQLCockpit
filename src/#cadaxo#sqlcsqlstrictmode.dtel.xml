   <LONGTEXTS>
    <item>
     <DOKIL>
      <ID>DE</ID>
      <OBJECT>/CADAXO/SQLCSQLSTRICTMODE</OBJECT>
      <LANGU>D</LANGU>
      <TYP>E</TYP>
      <VERSION>0008</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00016</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CADAXO/SQLCSQLSTRICTMODE</TDNAME>
      <TDID>DE</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00008</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEFINITION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Aktivierung des &lt;ZH&gt;SQL Strict Mode&lt;/&gt; für Abfragen im SQL Cockpit.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Der Strict Mode erzwingt eine strengere, regelkonforme Ausführung von</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SQL-Statements nach den aktuellen ABAP-Open-SQL-Richtlinien.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;USE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Das SQL Cockpit wandelt ABAP SQL Anweisungen automatisch in strikte ABAP</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>SQL Anweisungen um, wenn dieses Feature aktiviert ist.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Der Strict Mode hilft dabei:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>syntaktisch unsaubere oder veraltete SQL-Statements zu vermeiden</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Clean-Core- und ABAP-Cloud-kompatiblen Code zu fördern</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>unerwartete Laufzeitfehler frühzeitig zu erkennen</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Empfohlen für:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>S/4HANA- und Cloud-nahe Szenarien</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>qualitätsgesicherte Produktivabfragen</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEPENDENCIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Ohne Strict Mode (zulässig):</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>PE</TDFORMAT>
       <TDLINE>SELECT PARTNER TYPE FROM BUT000.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Korrekt im Strict Mode:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>PE</TDFORMAT>
       <TDLINE>SELECT FROM BUT000 FIELDS PARTNER, TYPE</TDLINE>
      </TLINE>
     </LINES>
    </item>
    <item>
     <DOKIL>
      <ID>DE</ID>
      <OBJECT>/CADAXO/SQLCSQLSTRICTMODE</OBJECT>
      <LANGU>E</LANGU>
      <TYP>E</TYP>
      <VERSION>0008</VERSION>
      <TXTLINES>00016</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CADAXO/SQLCSQLSTRICTMODE</TDNAME>
      <TDID>DE</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00008</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEFINITION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Checkbox to activate SQL Strict Mode for queries in SQL Cockpit.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Strict Mode enforces a stricter, rule-compliant execution of SQL</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>statements according to modern ABAP Open SQL standards.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;USE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>The SQL Cockpit automatically converts ABAP SQL statements into strict</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ABAP SQL statements when this feature is enabled.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Strict Mode helps to:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>avoid syntactically incorrect or outdated SQL statements</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>promote Clean Core and ABAP Cloud compliant code</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>detect unexpected runtime issues at an early stage</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Recommended for:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>S/4HANA and cloud-related scenarios</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>quality-assured productive queries</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEPENDENCIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Without Strict Mode:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>PE</TDFORMAT>
       <TDLINE>SELECT PARTNER TYPE FROM BUT000.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Corret Strict Mode:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>PE</TDFORMAT>
       <TDLINE>SELECT FROM BUT000 FIELDS PARTNER, TYPE</TDLINE>
      </TLINE>
     </LINES>
    </item>
   </LONGTEXTS>
