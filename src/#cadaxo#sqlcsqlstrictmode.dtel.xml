    <DDTEXT>SQL Cockpit - SQL Strict Mode</DDTEXT>
    <REPTEXT>StrictMode</REPTEXT>
    <SCRTEXT_S>StrictMode</SCRTEXT_S>
    <SCRTEXT_M>Strict Mode</SCRTEXT_M>
    <SCRTEXT_L>Strict Mode</SCRTEXT_L>
