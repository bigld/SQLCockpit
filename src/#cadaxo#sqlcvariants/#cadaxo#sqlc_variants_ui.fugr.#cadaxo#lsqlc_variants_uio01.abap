MODULE status_0100 OUTPUT.
****************************************************************************************************
* Description             : Status 0100                                                            *
*--------------------------------------------------------------------------------------------------*
* Additional informations :                                                                        *
*                                                                                                  *
*--------------------------------------------------------------------------------------------------*
* Developer               : Johann Fößleitner        Company    : CADAXO GesmbH                    *
* Date                    : 01.10.2012               Release    : WAS 7.00                         *
*--------------------------------------------------------------------------------------------------*
* Qual. Check(opt.)       : xxxxxx xxxxxxxxxxx       Company    : xxxxxx xxxxxx                    *
* Date                    : xx.xx.xxxx                                                             *
*--------------------------------------------------------------------------------------------------*
*                                                                                                  *
*-----------E N H A N C E M E N T S / C O R R E C T I O N S / M O D I F I C A T I O N S -----------*
*                                                                                                  *
* Date       | Developer            | Description                                 |                *
*------------+----------------------+---------------------------------------------+----------------*
*            |                      |                                             |                *
*            |                      |                                             |                *
*------------+----------------------+---------------------------------------------+----------------*
*            |                      |                                             |                *
*            |                      |                                             |                *
****************************************************************************************************



  CLEAR lt_excluding_fcode.

* deactivate CONTINUE if no variant is selected
  IF gcl_controller->gs_il_variants-varguid IS INITIAL.
    APPEND 'CONTINUE' TO lt_excluding_fcode.
  ENDIF.

* set pf status
  SET PF-STATUS '0100_G' EXCLUDING lt_excluding_fcode.

ENDMODULE.                 " STATUS_0100  OUTPUT
