MODULE modify_screen_0100 OUTPUT.
****************************************************************************************************
* Description             : Modify Screen 0100                                                     *
*--------------------------------------------------------------------------------------------------*
* Additional informations :                                                                        *
*                                                                                                  *
*--------------------------------------------------------------------------------------------------*
* Developer               : Johann Fößleitner        Company    : CADAXO GesmbH                    *
* Date                    : 01.10.2012               Release    : WAS 7.00                         *
*--------------------------------------------------------------------------------------------------*
* Qual. Check(opt.)       : xxxxxx xxxxxxxxxxx       Company    : xxxxxx xxxxxx                    *
* Date                    : xx.xx.xxxx                                                             *
*--------------------------------------------------------------------------------------------------*
*                                                                                                  *
*-----------E N H A N C E M E N T S / C O R R E C T I O N S / M O D I F I C A T I O N S -----------*
*                                                                                                  *
* Date       | Developer            | Description                                 |                *
*------------+----------------------+---------------------------------------------+----------------*
*            |                      |                                             |                *
*            |                      |                                             |                *
*------------+----------------------+---------------------------------------------+----------------*
*            |                      |                                             |                *
*            |                      |                                             |                *
****************************************************************************************************

*depending on the selected language, set radio buttons
  CASE gcl_controller->g_description_language.
    WHEN 'D'.
      MOVE 'X' TO rad_langu_d.
      MOVE ' ' TO rad_langu_e.
    WHEN 'E'.
      MOVE ' ' TO rad_langu_d.
      MOVE 'X' TO rad_langu_e.
  ENDCASE.

* deactivate screen elements, if no variant is selected
  LOOP AT SCREEN.
    IF screen-group1 EQ 'DES'.
      IF gcl_controller->gs_il_variants IS INITIAL OR
         gcl_controller->g_mode eq 'R'.
        screen-input = 0.
      ELSE.
        screen-input = 1.
      ENDIF.
      MODIFY SCREEN.
    ENDIF.
  ENDLOOP.

ENDMODULE.                 " MODIFY_SCREEN_0100  OUTPUT
