   <DD04_TEXTS>
    <item>
     <DDLANGUAGE>D</DDLANGUAGE>
     <DDTEXT>SQL Cockpit - Domain Texte ergänzen</DDTEXT>
     <REPTEXT>Domain Text</REPTEXT>
     <SCRTEXT_S>Domain</SCRTEXT_S>
     <SCRTEXT_M>Domain Text</SCRTEXT_M>
     <SCRTEXT_L>Domain Text ergänzen</SCRTEXT_L>
    </item>
   </DD04_TEXTS>
   <LONGTEXTS>
    <item>
     <DOKIL>
      <ID>DE</ID>
      <OBJECT>/CADAXO/SQLCADDDOMAINTEXT</OBJECT>
      <LANGU>D</LANGU>
      <TYP>E</TYP>
      <VERSION>0006</VERSION>
      <TXTLINES>00013</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CADAXO/SQLCADDDOMAINTEXT</TDNAME>
      <TDID>DE</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00006</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEFINITION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Checkbox zur Steuerung, ob bei der Ausgabe von Feldern mit</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Domain-Festwerten automatisch die zugehörigen Textbeschreibungen ergänzt</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>=</TDFORMAT>
       <TDLINE> werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Die Funktion ist nur im &lt;ZH&gt;SQL Strict Mode&lt;/&gt; aktiv.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;USE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Wenn diese Option aktiviert ist, werden bei Abfragen im SQL Cockpit</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>zusätzlich zu den technischen Festwerten auch deren sprachabhängige</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Texte angezeigt.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEPENDENCIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Wirkt nur, wenn der SQL Strict Mode aktiviert ist.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Funktioniert nur für Felder mit:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>zugeordneter Domain</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>gepflegten Festwerten inkl. Texten</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Sprachabhängig (basierend auf der aktuellen Anmeldesprache).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Statt nur A wird automatisch A – Active ausgegeben.</TDLINE>
      </TLINE>
     </LINES>
    </item>
    <item>
     <DOKIL>
      <ID>DE</ID>
      <OBJECT>/CADAXO/SQLCADDDOMAINTEXT</OBJECT>
      <LANGU>E</LANGU>
      <TYP>E</TYP>
      <VERSION>0006</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00011</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CADAXO/SQLCADDDOMAINTEXT</TDNAME>
      <TDID>DE</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00006</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEFINITION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Checkbox to control whether &lt;ZH&gt;domain fixed values &lt;/&gt;are automatically</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>enriched with their &lt;ZH&gt;descriptive texts&lt;/&gt; in the output.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>This feature is only applied in SQL Strict Mode.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;USE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>When enabled, query results in SQL Cockpit will show the descriptive</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>text of domain fixed values in addition to the technical value.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEPENDENCIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Only effective when SQL Strict Mode is active.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Works only for fields that:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>have an assigned domain</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B2</TDFORMAT>
       <TDLINE>contain maintained fixed values with texts</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>Language-dependent (based on logon language).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Instead of only A, the output will be A – Active.</TDLINE>
      </TLINE>
     </LINES>
    </item>
   </LONGTEXTS>
  </asx:values>
 </asx:abap>
