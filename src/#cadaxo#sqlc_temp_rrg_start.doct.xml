     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>SQL Cockpit - Rapid Report Generator Assistent</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Verwenden Sie diesen Assistenten, um eine ABAP Klasse und eine</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Ergebnisstruktur aus Ihrer aktuellen SELECT-Anweisung zu generieren und</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>diese sofort im Rapid Report Generator einzubinden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Navigieren Sie zur Erzeugung mit den Schaltflächen &lt;ZH&gt;Zurück&lt;/&gt; und</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>&lt;ZH&gt;Weiter&lt;/&gt; unten oder mit der Übersicht links.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Am Ende erhalten Sie eine Zusammenfassung und können die Erzeugung mit</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der Schaltfläche &lt;ZH&gt;Objekte generieren&lt;/&gt; starten.</TDLINE>
      </TLINE>
     </LINES>
    </item>
